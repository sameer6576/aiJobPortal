# IntelliJ services + Compose PostgreSQL containers (published host ports).
# Copy to docker/local-hybrid.env (gitignored) and fill secrets.
# Start DBs: docker compose up -d userdb companydb jobdb applicationdb preferencedb resumedb

DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=

USER_DB_PORT=5433
COMPANY_DB_PORT=5434
JOB_DB_PORT=5435
APPLICATION_DB_PORT=5436
PREFERENCE_DB_PORT=5439
RESUME_DB_PORT=5440
