# IntelliJ + Homebrew (or any) PostgreSQL on :5432.
# Copy to docker/local-native.env (gitignored) and fill secrets.
# Point EnvFile at this file (and/or docker/.env for the same secret keys).
#
# Create databases: job_portal_user, job_portal_company, job_portal_job,
# job_portal_application, job_portal_preference, job_portal_resume.

DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=

USER_DB_PORT=5432
COMPANY_DB_PORT=5432
JOB_DB_PORT=5432
APPLICATION_DB_PORT=5432
PREFERENCE_DB_PORT=5432
RESUME_DB_PORT=5432
